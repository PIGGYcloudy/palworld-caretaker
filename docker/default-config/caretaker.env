# Docker-specific persistent paths.  Do not change mount destinations.
PALWORLD_INSTALL_ROOT=/srv/palworld
PALWORLD_SERVER_ROOT=/srv/palworld
PALWORLD_BACKUP_DIR=/srv/palworld-backups
PALWORLD_BACKUP_MOUNT=
PALWORLD_BACKUP_REQUIRE_MOUNT=false
PALWORLD_MANAGER_STATE_DIR=/srv/palworld/.caretaker-state
PALWORLD_SERVICE_USER=steam
PALWORLD_MANAGER_USER=steam
PALWORLD_WEB_UI_USERNAME=palworld-manager
PALWORLD_WEB_BIND_IP=0.0.0.0
PALWORLD_WEB_PUBLIC_ORIGIN=
PALWORLD_WEB_ALLOWED_ORIGINS=
PALWORLD_WEB_ALLOWED_HOSTS=
PALWORLD_SAVEGAMES_EXPORT_MAX_BYTES=8589934592
PALWORLD_MEMORY_ALERT_PERCENT=85
PALWORLD_MEMORY_ALERT_COOLDOWN_SECONDS=1800
BACKUP_RETENTION_COUNT=14
BACKUP_TIME=daily-04:30
PALWORLD_ONBOARDING_COMPLETED=false
