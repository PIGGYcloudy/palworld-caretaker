[Unit]
Description=Palworld Backup and Update Schedule Timer

[Timer]
# A minute cadence lets daily-palworld-maintenance.sh reload daily and
# interval schedules after a manager-owned editable config change. Its gate
# prevents extra maintenance runs and keeps manual maintenance independent.
OnCalendar=*-*-* *:*:00
Persistent=true
Unit=palworld-scheduled-maintenance.service

[Install]
WantedBy=timers.target
