[Unit]
Description=Palworld empty-server shutdown watcher
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=@MANAGER_USER@
Group=@MANAGER_USER@
Environment=@CONFIG_ENV@
Environment=@IDLE_STATE_ENV@
ExecStart=@VENV_PYTHON@ @IDLE_SCRIPT@
Restart=on-failure
RestartSec=10s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=@STATE_DIR@

[Install]
WantedBy=multi-user.target
