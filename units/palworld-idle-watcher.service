[Unit]
Description=Palworld empty-server shutdown watcher
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=palworld-manager
Group=palworld-manager
Environment=PALWORLD_CONFIG=/srv/palworld/config/palworld.env
Environment=PALWORLD_STATE=/var/lib/palworld-manager/idle-state.json
ExecStart=/srv/palworld/venv/bin/python /srv/palworld/scripts/palworld-idle-watcher.py
Restart=on-failure
RestartSec=10s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/palworld-manager

[Install]
WantedBy=multi-user.target
