[Unit]
Description=Palworld Caretaker local web UI (loopback only)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=@MANAGER_USER@
Group=@MANAGER_USER@
Environment=@CONFIG_ENV@
ExecStart=@VENV_PYTHON@ @WEB_UI_SCRIPT@
Restart=on-failure
RestartSec=10s
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadOnlyPaths=@CONFIG_ROOT@
# Only the manager-owned non-secret layer is writable.  The protected config
# root and secrets.env remain read-only inside this service.
ReadWritePaths=@CONFIG_ROOT@/editable
# The installer creates this manager-owned 0640 file.  Keeping the parent
# read-only prevents the web service from changing maintenance state.
ReadWritePaths=@STATE_DIR@/audit.log
ReadOnlyPaths=@STATE_DIR@/maintenance-state.json
# SettingsStore writes rollback records only below this installer-created
# manager-owned state child; the rest of the state tree remains read-only.
ReadWritePaths=@SETTINGS_BACKUP_DIR@
ReadOnlyPaths=/run/palworld-caretaker

[Install]
WantedBy=multi-user.target
