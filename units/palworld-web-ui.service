[Unit]
Description=Palworld Caretaker local web UI (loopback only)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=@MANAGER_USER@
Group=@MANAGER_USER@
Environment=@CONFIG_ENV@
ExecStart=@VENV_PYTHON@ @WEB_UI_SCRIPT@
Restart=on-failure
RestartSec=10s
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadOnlyPaths=@CONFIG_ROOT@
ReadOnlyPaths=/run/palworld-caretaker

[Install]
WantedBy=multi-user.target
