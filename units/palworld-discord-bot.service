[Unit]
Description=Palworld Discord control bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=palworld-manager
Group=palworld-manager
Environment=PALWORLD_CONFIG=/srv/palworld/config/palworld.env
Environment=PALWORLD_STATE=/var/lib/palworld-manager/idle-state.json
ExecStart=/srv/palworld/venv/bin/python /srv/palworld/scripts/palworld-discord-bot.py
Restart=always
RestartSec=10s
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/palworld-manager /run/lock

[Install]
WantedBy=multi-user.target
