[Unit]
Description=Palworld Discord control bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=@MANAGER_USER@
Group=@MANAGER_USER@
Environment=@CONFIG_ENV@
Environment=@IDLE_STATE_ENV@
Environment=@MAINTENANCE_STATE_ENV@
ExecStart=@VENV_PYTHON@ @DISCORD_SCRIPT@
Restart=always
RestartSec=10s
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=@STATE_DIR@ /run/palworld-caretaker

[Install]
WantedBy=multi-user.target
