# Caretaker deployment configuration. Copy to caretaker.env.
# Every path must be absolute. Derived paths (server, config, scripts, and
# backups-local) live below PALWORLD_INSTALL_ROOT and must not be repeated here.

PALWORLD_INSTALL_ROOT=/srv/palworld
PALWORLD_MANAGER_STATE_DIR=/var/lib/palworld-manager
PALWORLD_SERVICE_USER=palworld
PALWORLD_MANAGER_USER=palworld-manager
# The local Web UI always requires HTTP Basic authentication.  The password is
# taken from PALWORLD_WEB_UI_PASSWORD in secrets.env, or ADMIN_PASSWORD when it
# is left empty for backwards-compatible deployments.
PALWORLD_WEB_UI_USERNAME=palworld-manager
# IPv4 listener for the authenticated Web UI. Keep 127.0.0.1 for local-only
# access; use 0.0.0.0 or a private LAN/VPN address only behind trusted access
# controls (and TLS for any untrusted network).
PALWORLD_WEB_BIND_IP=127.0.0.1
# Non-loopback listeners accept only these exact browser origins and Host
# authorities.  Keep all three blank for local-only loopback use.  For direct
# LAN access, set the exact HTTP origin; for a TLS reverse proxy, set its exact
# public HTTPS origin.  Comma-separate additional origins/hosts when needed.
# PALWORLD_WEB_PUBLIC_ORIGIN=https://pal.example.net
# PALWORLD_WEB_ALLOWED_ORIGINS=http://192.168.1.20:8765
# PALWORLD_WEB_ALLOWED_HOSTS=pal.example.net
# The authenticated local UI refuses SaveGames archives larger than this
# amount, and also requires this much free scratch space before it starts.
PALWORLD_SAVEGAMES_EXPORT_MAX_BYTES=8589934592
# Alert Discord once when host RAM reaches this percentage. It re-arms only
# after recovery below the threshold and respects the cooldown.
PALWORLD_MEMORY_ALERT_PERCENT=85
PALWORLD_MEMORY_ALERT_COOLDOWN_SECONDS=1800

# The backup directory may be anywhere outside the installation root. When the
# destination is a NAS/removable filesystem, keep mount checking enabled so a
# missing mount can never silently write backups to the root filesystem.
PALWORLD_BACKUP_DIR=/mnt/qnap-tyt/palworld-backups
PALWORLD_BACKUP_MOUNT=/mnt/qnap-tyt
PALWORLD_BACKUP_REQUIRE_MOUNT=true
BACKUP_RETENTION_COUNT=14
BACKUP_TIME=04:30
