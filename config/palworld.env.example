# Legacy combined Palworld deployment configuration.
# The installer copies this file to /srv/palworld/config/palworld.env.
# Edit the installed file with sudo. Never commit real passwords or tokens.
# New deployments should use caretaker.env, server.env, and secrets.env. This
# combined template remains supported for existing /srv/palworld deployments.

MAX_PLAYERS=10
BASE_CAMP_MAX_NUM_IN_GUILD=10
SERVER_PASSWORD='CHANGE_ME_SERVER_PASSWORD'
ADMIN_PASSWORD='CHANGE_ME_ADMIN_PASSWORD'
SERVER_NAME='Palworld Dedicated Server'
SERVER_DESCRIPTION='Private Palworld Dedicated Server'
PUBLIC_PORT=8211

# Palworld's official REST API. Keep this port blocked from every non-loopback
# interface; the installer enables palworld-rest-firewall.service for this.
PALWORLD_REST_API_HOST=127.0.0.1
PALWORLD_REST_API_PORT=8212
PALWORLD_REST_API_USERNAME=admin
PALWORLD_API_TIMEOUT_SECONDS=5
PALWORLD_SAVEGAMES_EXPORT_MAX_BYTES=8589934592

# Empty-server watcher defaults. Start with dry-run=true for the first live test.
PALWORLD_IDLE_SHUTDOWN_ENABLED=true
PALWORLD_IDLE_TIMEOUT_MINUTES=10
PALWORLD_PLAYER_CHECK_INTERVAL_SECONDS=60
PALWORLD_STARTUP_GRACE_SECONDS=600
PALWORLD_SHUTDOWN_WAIT_SECONDS=30
PALWORLD_IDLE_WATCHER_DRY_RUN=true
PALWORLD_START_READY_TIMEOUT_SECONDS=180
# Discord receives one proactive alert after RAM crosses the threshold. The
# notification re-arms after recovery and is rate limited by the cooldown.
PALWORLD_MEMORY_ALERT_PERCENT=85
PALWORLD_MEMORY_ALERT_COOLDOWN_SECONDS=1800

# Discord slash-command bot. Numeric IDs may be comma-separated. Empty allow
# lists deny every command. Never commit or share the real bot token.
DISCORD_BOT_TOKEN='CHANGE_ME_DISCORD_BOT_TOKEN'
DISCORD_PALWORLD_ALLOWED_GUILD_IDS=
DISCORD_PALWORLD_ALLOWED_ROLE_IDS=
DISCORD_PALWORLD_ADMIN_ROLE_IDS=
DISCORD_PALWORLD_ALLOWED_CHANNEL_IDS=

# Daily NAS snapshots. The installer uses 14 versions by default.
BACKUP_RETENTION_COUNT=14
BACKUP_TIME='04:30'
