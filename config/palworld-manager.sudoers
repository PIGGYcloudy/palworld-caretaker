# The Discord bot can invoke only fixed, argument-free administrative actions;
# it cannot run shell commands or stop/reconfigure arbitrary services.
@MANAGER_USER@ ALL=(root) NOPASSWD: /usr/local/sbin/palworld-control start, \
    /usr/bin/systemctl is-active palworld-maintenance.service, \
    @GRACEFUL_STOP_SCRIPT@, \
    /usr/bin/systemctl start palworld-backup.service --wait, \
    /usr/bin/systemctl start palworld-maintenance.service --no-block
