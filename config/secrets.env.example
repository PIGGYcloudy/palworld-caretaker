# Secrets only. Copy to secrets.env, replace placeholders, and chmod 0640.
# The file is root-owned and group-readable by PALWORLD_MANAGER_USER so the
# loopback Web UI and optional Discord bot can authenticate to local REST.
# Never commit, log, or share the installed file.

SERVER_PASSWORD='CHANGE_ME_SERVER_PASSWORD'
ADMIN_PASSWORD='CHANGE_ME_ADMIN_PASSWORD'
# Optional dedicated password for the Web UI. If empty, ADMIN_PASSWORD is
# used; when both are empty, only a loopback-bound UI allows local access
# without HTTP Basic authentication.
PALWORLD_WEB_UI_PASSWORD=''
DISCORD_BOT_TOKEN='CHANGE_ME_DISCORD_BOT_TOKEN'
