#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'
umask 077

(( EUID == 0 )) || { printf 'Run this tool with sudo.\n' >&2; exit 1; }
CONFIG_DIR="${PALWORLD_CONFIG_DIR:-/srv/palworld/config}"
if (( $# > 0 )); then
  [[ $# -eq 2 && "$1" == --config-dir ]] || {
    printf 'Usage: %s [--config-dir DIRECTORY]\n' "$0" >&2; exit 2;
  }
  CONFIG_DIR="$2"
fi
[[ -d "$CONFIG_DIR" ]] || { printf 'Palworld configuration directory was not found: %s\n' "$CONFIG_DIR" >&2; exit 1; }
CONFIG_DIR="$(realpath -m -- "$CONFIG_DIR")"
INSTALL_ROOT="$(dirname -- "$CONFIG_DIR")"
MANAGER="$INSTALL_ROOT/scripts/palworld_manager.py"
[[ -r "$MANAGER" ]] || { printf 'Configuration manager was not found: %s\n' "$MANAGER" >&2; exit 1; }
python3 "$MANAGER" --config-dir "$CONFIG_DIR" --no-filesystem >/dev/null || exit $?
MANAGER_USER="$(python3 "$MANAGER" --config-dir "$CONFIG_DIR" --get PALWORLD_MANAGER_USER)"

if [[ -f "$CONFIG_DIR/secrets.env" || -f "$CONFIG_DIR/server.env" || -f "$CONFIG_DIR/editable/server.env" ]]; then
  TOKEN_CONFIG="$CONFIG_DIR/secrets.env"
  IDS_CONFIG="$CONFIG_DIR/server.env"
  IDS_OWNER="root:$MANAGER_USER"
  if [[ -f "$CONFIG_DIR/editable/server.env" ]]; then
    IDS_CONFIG="$CONFIG_DIR/editable/server.env"
    IDS_OWNER="$MANAGER_USER:$MANAGER_USER"
  fi
  [[ -f "$TOKEN_CONFIG" && -f "$IDS_CONFIG" ]] || {
    printf 'Layered deployments require both secrets.env and server.env.\n' >&2; exit 1;
  }
  TOKEN_OWNER="root:$MANAGER_USER"
else
  TOKEN_CONFIG="$CONFIG_DIR/palworld.env"
  IDS_CONFIG="$TOKEN_CONFIG"
  TOKEN_OWNER="root:$MANAGER_USER"
  IDS_OWNER="$TOKEN_OWNER"
  [[ -f "$TOKEN_CONFIG" ]] || { printf 'No supported deployment configuration was found.\n' >&2; exit 1; }
fi
[[ -f /etc/systemd/system/palworld-discord-bot.service ]] || {
  printf 'Install the Palworld manager upgrade first.\n' >&2; exit 1;
}

printf 'Discord Application ID: '
read -r application_id
printf 'Discord Bot token (input hidden): '
read -rs token
printf '\nAllowed Discord server (guild) ID: '
read -r guild_ids
printf 'Allowed channel ID (comma-separated), or * for every channel: '
read -r channel_ids
printf 'Allowed role ID (comma-separated if needed): '
read -r role_ids
printf 'Administrator role ID (comma-separated if needed): '
read -r admin_ids

[[ "$application_id" =~ ^[0-9]{15,22}$ ]] || { printf 'Invalid Application ID.\n' >&2; exit 2; }
[[ "$token" =~ ^[A-Za-z0-9._-]{20,}$ ]] || { printf 'Invalid Bot token format.\n' >&2; exit 2; }
validate_ids() { [[ "$1" =~ ^[0-9]{15,22}(,[0-9]{15,22})*$ ]]; }
validate_ids "$guild_ids" || { printf 'Invalid guild ID list.\n' >&2; exit 2; }
[[ "$channel_ids" == '*' ]] || validate_ids "$channel_ids" || { printf 'Invalid channel ID list.\n' >&2; exit 2; }
validate_ids "$role_ids" || { printf 'Invalid allowed role ID list.\n' >&2; exit 2; }
validate_ids "$admin_ids" || { printf 'Invalid administrator role ID list.\n' >&2; exit 2; }

stamp="$(date +%Y%m%d-%H%M%S)"
backups=()
temporary_files=()
cleanup() { ((${#temporary_files[@]} == 0)) || rm -f -- "${temporary_files[@]}"; }
trap cleanup EXIT

backup_config() {
  local source=$1 backup="${1}.pre-discord-$stamp"
  if [[ ! -e "$backup" ]]; then
    install -o root -g root -m 0600 "$source" "$backup"
    backups+=("$backup")
  fi
}

replace_discord_values() {
  local config=$1 mode=$2 owner=$3 temporary line key replacement matched
  shift 3
  backup_config "$config"
  temporary="$(mktemp "${config}.tmp.XXXXXX")"
  temporary_files+=("$temporary")
  while IFS= read -r line || [[ -n "$line" ]]; do
    key=${line%%=*}
    key=${key#"${key%%[![:space:]]*}"}
    key=${key%"${key##*[![:space:]]}"}
    matched=false
    for replacement in "$@"; do
      [[ "${replacement%%=*}" == "$key" ]] && { matched=true; break; }
    done
    [[ "$matched" == true ]] && continue
    printf '%s\n' "$line"
  done < "$config" > "$temporary"
  for line in "$@"; do printf '%s\n' "$line" >> "$temporary"; done
  chown "$owner" "$temporary"
  chmod "$mode" "$temporary"
  mv -f -- "$temporary" "$config"
}

replace_discord_values "$TOKEN_CONFIG" 0640 "$TOKEN_OWNER" "DISCORD_BOT_TOKEN='$token'"
replace_discord_values "$IDS_CONFIG" 0640 "$IDS_OWNER" \
  "DISCORD_PALWORLD_ALLOWED_GUILD_IDS=$guild_ids" \
  "DISCORD_PALWORLD_ALLOWED_CHANNEL_IDS=$channel_ids" \
  "DISCORD_PALWORLD_ALLOWED_ROLE_IDS=$role_ids" \
  "DISCORD_PALWORLD_ADMIN_ROLE_IDS=$admin_ids"
unset token

python3 "$MANAGER" --config-dir "$CONFIG_DIR" --no-filesystem >/dev/null || {
  printf 'Updated Discord configuration failed validation; restore: %s\n' "${backups[*]}" >&2
  exit 3
}

systemctl daemon-reload
systemctl enable --now palworld-discord-bot.service >/dev/null
sleep 3
if ! systemctl is-active --quiet palworld-discord-bot.service; then
  printf 'Bot failed to start. Review: sudo journalctl -u palworld-discord-bot.service -n 50\n' >&2
  exit 3
fi

printf '\nBot is running. Invite it to the Discord server whose guild ID you entered:\n'
printf 'https://discord.com/oauth2/authorize?client_id=%s&permissions=3072&integration_type=0&scope=bot%%20applications.commands\n' "$application_id"
printf '\nThe token was stored only in the protected secrets layer. Backup(s):\n'
printf '  %s\n' "${backups[@]}"
