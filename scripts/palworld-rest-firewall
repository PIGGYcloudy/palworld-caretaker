#!/usr/bin/env bash
set -euo pipefail

SCRIPT_HOME="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_DIR="${PALWORLD_CONFIG_DIR:-$(dirname -- "$SCRIPT_HOME")/config}"
MANAGER="$SCRIPT_HOME/palworld_manager.py"
[[ -r "$MANAGER" ]] || exit 1
python3 "$MANAGER" --config-dir "$CONFIG_DIR" || exit $?
PORT="$(python3 "$MANAGER" --config-dir "$CONFIG_DIR" --get PALWORLD_REST_API_PORT)"
action="${1:-}"
[[ "$action" == start || "$action" == stop ]] || exit 2

manage() {
  local command="$1" binary="$2"
  command -v "$binary" >/dev/null 2>&1 || return 0
  if [[ "$command" == start ]]; then
    "$binary" -w -C INPUT ! -i lo -p tcp --dport "$PORT" -j REJECT 2>/dev/null ||
      "$binary" -w -I INPUT 1 ! -i lo -p tcp --dport "$PORT" -j REJECT
  else
    "$binary" -w -D INPUT ! -i lo -p tcp --dport "$PORT" -j REJECT 2>/dev/null || true
  fi
}

manage "$action" iptables
manage "$action" ip6tables
